# ── Rust / Tauri core ──
/src-tauri/target/
**/target/
*.rs.bk
*.pdb

# ── Node / web frontend ──
node_modules/
dist-ssr/
.vite/
*.local
# NOTE: root /dist/ is NOT ignored — this is a no-build app, so dist/ holds
# hand-authored frontend SOURCE (panel.html/css/js), not generated output.
# The CI signing artifacts under src-tauri/dist/ ARE generated, so ignore those:
/src-tauri/dist/

# ── Tauri build output ──
/src-tauri/gen/
/src-tauri/WixTools/
/desktop/gen/
/desktop/WixTools/

# ── Editors / OS ──
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ── Logs / env ──
*.log
.env
.env.*
!.env.example

# ── Local link-graph data (never commit a user's graph) ──
*.sqlite
*.sqlite-wal
*.sqlite-shm
/local-data/

# ── Manifold working state is KEPT in git (it is the spec). ──
# .manifold/ is intentionally NOT ignored.

# ── Context cache (local only) ──
/.context/

# context-hygiene runtime cache
.context/
# Added by code-review-graph
.code-review-graph/

.world-model/

# ── AI coding-agent scaffolding (local/per-user, not shared) ──
# .claude/ is ignored EXCEPT settings.json — the shared, portable agent config
# (least-privilege permissions). Personal hooks stay in the ignored settings.local.json.
.claude/*
!.claude/settings.json
.cursor/
.cursorrules
.kiro/
.mcp.json
.opencode.json
.serena/
.windsurfrules
AGENTS.md
CLAUDE.md
GEMINI.md
