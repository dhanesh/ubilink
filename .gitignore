# ── Rust ──
/core/target
**/target/
*.rs.bk
*.pdb

# ── Node (the plugin sandbox host) ──
node_modules/
*.local
# The CI signing artifacts under core/dist/ are generated:
/core/dist/

# ── App bundles (scripts/bundle-macos.sh: Ubilink.app + DMG) ──
/desktop-gpui/bundle/

# ── Editors / OS ──
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ── Logs / env ──
*.log
.env
.env.*
!.env.example

# ── Local link-graph data (never commit a user's graph) ──
*.sqlite
*.sqlite-wal
*.sqlite-shm
/local-data/

# ── Manifold working state is KEPT in git (it is the spec). ──
# .manifold/ is intentionally NOT ignored.

# ── Context cache (local only) ──
/.context/

# context-hygiene runtime cache
.context/
# Added by code-review-graph
.code-review-graph/

.world-model/

# ── AI coding-agent scaffolding (local/per-user, not shared) ──
# .claude/ is ignored EXCEPT settings.json and hooks/ — the shared, portable agent config (settings.json references the hook scripts)
# (least-privilege permissions). Personal hooks stay in the ignored settings.local.json.
.claude/*
!.claude/settings.json
!.claude/hooks/
.cursor/
.cursorrules
.kiro/
.mcp.json
.opencode.json
.serena/
.windsurfrules
AGENTS.md
CLAUDE.md
GEMINI.md

# Python bytecode from running scripts/test_probe.py (unittest imports the module).
__pycache__/

# verify-ubilink evidence (.verify/) and per-instance run state (.verify-run/):
# local records the evidence gate reads, never committed.
.verify/
.verify-run/
