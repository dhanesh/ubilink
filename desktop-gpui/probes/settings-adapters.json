        "role": "Switch",
        "text": "Arc",
        "exact": true,
        "state": {
          "focused": true
        }
      },
      "route": "settings"
    },
    {
      "name": "off 1/8: Space",
      "call": "key",
      "args": {
        "keys": "space"
      }
