      "name": "capture: open",
      "call": "open_view",
      "args": {
        "route": "capture"
      },
      "expect": {
        "route": "capture",
        "shell.visible": true
      }
    },
    {
      "name": "capture: window id",
      "call": "window_id",
      "expect": {
        "window_id": {
          "type": "number",
          "gt": 0
        }
      },
      "save": {
        "wid_capture": "window_id"
      }
    },
    {
      "name": "capture/light: set_appearance",
      "call": "set_appearance",
      "args": {
        "mode": "light"
      },
      "expect": {
        "theme": "light",
        "override": "light"
      }
    },
    {
      "name": "capture/light: same process",
      "process": "unchanged"
    },
    {
      "name": "capture/light: same window, still on capture",
      "call": "window_id",
      "expect": {
        "window_id": {
          "saved": "wid_capture"
        }
      }
    },
    {
      "call": "state",
      "expect": {
        "route": "capture",
        "appearance.theme": "light"
      }
    },
    {
      "name": "capture/light: opaque surface",
      "pixel": "view.theme_samples.surface",
      "color": "#ffffff",
      "delta_e": 3
    },
    {
      "name": "capture/light: primary text run",
      "pixel": "view.theme_samples.text",
      "color": "#262626",
      "delta_e": 3,
      "match": "best"
    },
