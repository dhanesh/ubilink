      "name": "plain/light: Cancel is left of Copy link",
      "call": "state",
      "retry_ms": 2000,
      "expect": {
        "view.layout.cancel_button.right": {
          "le": {
            "path": "view.layout.copy_button.x"
          }
        }
      }
    },
    {
      "name": "plain/light: Cancel is inside the footer",
      "call": "state",
      "retry_ms": 2000,
      "expect": {
        "view.layout.cancel_button.y": {
          "ge": {
            "path": "view.layout.footer.y"
          }
        }
