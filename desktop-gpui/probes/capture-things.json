      "call": "state",
      "retry_ms": 2000,
      "expect": {
        "view.theme_samples.text.y": {
          "lt": {
            "path": "view.layout.footer.y"
          }
        }
      }
    },
    {
      "name": "plain/light: the footer is inside the window",
