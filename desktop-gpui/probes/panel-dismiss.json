{
 "description": "R5 dismiss: capture and browser hide on loss of key status (resign_key and a real activation of another app); settings and onboarding stay open",
 "requirement": "R5 (GPUI Phase 0)",
 "notes": [
  "resign_key runs the click-away rule through PanelView::activation_changed, the code the window-activation observer runs; activate_other ('open -a Finder') is the real AppKit loss of key status.",
  "Hidden means three things: state.shell.visible false, the shell has no panel (window_id refuses), and the window number winframe saw is gone from Quartz's on-screen window list (winframe: gone).",
  "Kept open means state.shell.visible true on the same route and the window still within a display.",
  "Onboarding has no hotkey; it opens through open_view (the tray's path).",
  "activate_other launches the probe's own activator app (scripts/probe-helpers/activator.swift), which takes key status and quits at the end of the step: always a real change of active app, and no user app is launched (O4).",
  "Each case is a block: if another app takes focus during a visibility check, the probe re-runs that block once and reports ENV-BLOCKED on a second theft (probes/README.md)."
 ],
 "steps": [
  {
   "call": "trigger_hotkey",
   "args": {
    "action": "capture"
   },
   "expect": {
    "route": "capture"
   },
   "name": "capture: open",
   "block": "capture-resign-key"
  },
  {
   "name": "capture: shown",
   "call": "state",
   "retry_ms": 3000,
   "expect": {
    "shell.visible": true,
    "route": "capture",
    "window_verified": true
   },
   "block": "capture-resign-key"
  },
  {
   "name": "capture: on screen",
   "winframe": "any",
   "block": "capture-resign-key"
  },
  {
   "name": "capture: resign_key hides",
   "call": "resign_key",
   "expect": {
    "route": "capture",
    "closed": true,
    "state.shell.visible": false,
    "state.route": null
   },
   "block": "capture-resign-key"
  },
  {
   "name": "capture: shell has no panel",
   "call": "window_id",
   "expect_error": "no panel open",
   "block": "capture-resign-key"
  },
  {
   "name": "capture: window left the screen (resign_key)",
   "winframe": "gone",
   "block": "capture-resign-key"
  },
  {
   "call": "trigger_hotkey",
   "args": {
    "action": "capture"
   },
   "expect": {
    "route": "capture"
   },
   "name": "capture: reopen",
   "block": "capture-deactivate"
  },
  {
   "name": "capture: shown again",
   "call": "state",
   "retry_ms": 3000,
   "expect": {
    "shell.visible": true,
    "route": "capture"
   },
   "block": "capture-deactivate"
  },
  {
   "name": "capture: on screen again",
   "winframe": "any",
   "block": "capture-deactivate"
  },
  {
   "name": "capture: real loss of key status",
   "activate_other": true,
   "block": "capture-deactivate"
  },
  {
   "name": "capture: hidden by the real deactivation",
   "call": "state",
   "retry_ms": 3000,
   "expect": {
    "shell.visible": false,
    "route": null
   },
   "block": "capture-deactivate"
  },
  {
   "name": "capture: window left the screen (activate_other)",
   "winframe": "gone",
   "block": "capture-deactivate"
  },
  {
   "call": "trigger_hotkey",
   "args": {
    "action": "browser"
   },
   "expect": {
    "route": "browser"
   },
   "name": "browser: open",
   "block": "browser-resign-key"
  },
  {
   "name": "browser: shown",
   "call": "state",
   "retry_ms": 3000,
   "expect": {
    "shell.visible": true,
    "route": "browser",
    "window_verified": true
   },
   "block": "browser-resign-key"
  },
  {
   "name": "browser: on screen",
   "winframe": "any",
   "block": "browser-resign-key"
  },
  {
   "name": "browser: resign_key hides",
   "call": "resign_key",
   "expect": {
    "route": "browser",
    "closed": true,
    "state.shell.visible": false,
    "state.route": null
   },
   "block": "browser-resign-key"
  },
  {
   "name": "browser: shell has no panel",
   "call": "window_id",
   "expect_error": "no panel open",
   "block": "browser-resign-key"
  },
  {
   "name": "browser: window left the screen (resign_key)",
   "winframe": "gone",
   "block": "browser-resign-key"
  },
  {
   "call": "trigger_hotkey",
   "args": {
    "action": "browser"
   },
   "expect": {
    "route": "browser"
   },
   "name": "browser: reopen",
   "block": "browser-deactivate"
  },
  {
   "name": "browser: shown again",
   "call": "state",
   "retry_ms": 3000,
   "expect": {
    "shell.visible": true,
    "route": "browser"
   },
   "block": "browser-deactivate"
  },
  {
   "name": "browser: on screen again",
   "winframe": "any",
   "block": "browser-deactivate"
  },
  {
   "name": "browser: real loss of key status",
   "activate_other": true,
   "block": "browser-deactivate"
  },
  {
   "name": "browser: hidden by the real deactivation",
   "call": "state",
   "retry_ms": 3000,
   "expect": {
    "shell.visible": false,
    "route": null
   },
   "block": "browser-deactivate"
  },
  {
   "name": "browser: window left the screen (activate_other)",
   "winframe": "gone",
   "block": "browser-deactivate"
  },
  {
   "call": "trigger_hotkey",
   "args": {
    "action": "settings"
   },
   "expect": {
    "route": "settings"
   },
   "name": "settings: open",
   "block": "settings-stays"
  },
  {
   "name": "settings: shown",
   "call": "state",
   "retry_ms": 3000,
   "expect": {
    "shell.visible": true,
    "route": "settings",
    "window_verified": true
   },
   "block": "settings-stays"
  },
  {
   "name": "settings: on screen",
   "winframe": "any",
   "block": "settings-stays"
  },
  {
   "name": "settings: resign_key keeps it",
   "call": "resign_key",
   "expect": {
    "route": "settings",
    "closed": false,
    "state.shell.visible": true,
    "state.route": "settings"
   },
   "block": "settings-stays"
  },
  {
   "name": "settings: still on screen (resign_key)",
   "winframe": "any",
   "block": "settings-stays"
  },
  {
   "name": "settings: real loss of key status",
   "activate_other": true,
   "settle_ms": 800,
   "block": "settings-stays"
  },
  {
   "name": "settings: still shown after the real deactivation",
   "call": "state",
   "expect": {
    "shell.visible": true,
    "route": "settings"
   },
   "block": "settings-stays"
  },
  {
   "name": "settings: still on screen (activate_other)",
   "winframe": "any",
   "block": "settings-stays"
  },
  {
   "name": "settings: still open later",
   "call": "window_id",
   "expect": {
    "window_id": {
     "type": "number",
     "gt": 0
    }
   },
   "block": "settings-stays"
  },
  {
   "name": "close settings",
   "call": "trigger_hotkey",
   "args": {
    "action": "settings"
   },
   "expect": {
    "shell.visible": false
   },
   "block": "settings-stays"
  },
  {
   "name": "settings: window left the screen (closed)",
   "winframe": "gone",
   "block": "settings-stays"
  },
  {
   "call": "open_view",
   "args": {
    "route": "onboarding"
   },
   "expect": {
    "route": "onboarding"
   },
   "name": "onboarding: open",
   "block": "onboarding-stays"
  },
  {
   "name": "onboarding: shown",
   "call": "state",
   "retry_ms": 3000,
   "expect": {
    "shell.visible": true,
    "route": "onboarding",
    "window_verified": true
   },
   "block": "onboarding-stays"
  },
  {
   "name": "onboarding: on screen",
   "winframe": "any",
   "block": "onboarding-stays"
  },
  {
   "name": "onboarding: resign_key keeps it",
   "call": "resign_key",
   "expect": {
    "route": "onboarding",
    "closed": false,
    "state.shell.visible": true,
    "state.route": "onboarding"
   },
   "block": "onboarding-stays"
  },
  {
   "name": "onboarding: still on screen (resign_key)",
   "winframe": "any",
   "block": "onboarding-stays"
  },
  {
   "name": "onboarding: real loss of key status",
   "activate_other": true,
   "settle_ms": 800,
   "block": "onboarding-stays"
  },
  {
   "name": "onboarding: still shown after the real deactivation",
   "call": "state",
   "expect": {
    "shell.visible": true,
    "route": "onboarding"
   },
   "block": "onboarding-stays"
  },
  {
   "name": "onboarding: still on screen (activate_other)",
   "winframe": "any",
   "block": "onboarding-stays"
  },
  {
   "name": "onboarding: still open later",
   "call": "window_id",
   "expect": {
    "window_id": {
     "type": "number",
     "gt": 0
    }
   },
   "block": "onboarding-stays"
  },
  {
   "name": "nothing launched",
   "call": "opened",
   "expect": {
    "": {
     "eq": []
    }
   }
  }
 ]
}
