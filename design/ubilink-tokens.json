{
  "$meta": {
    "name": "Ubilink Design Tokens",
    "description": "Tokens for the Ubilink HUD redesign. Two directions (aurora, console), dual-theme (light/dark via prefers-color-scheme). Accent = macOS system blue.",
    "themes": ["dark", "light"]
  },
  "font": {
    "ui": "-apple-system, \"SF Pro Text\", \"SF Pro Display\", system-ui, sans-serif",
    "mono": "\"SF Mono\", ui-monospace, Menlo, monospace"
  },
  "fontSize": { "display": 18, "title": 16, "row": 14, "body": 13, "meta": 12 },
  "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
  "radius": { "panel": 17, "card": 12, "row": 10, "tile": 7, "control": 8, "kbd": 6, "pill": 999 },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40 },
  "material": { "blur": 42, "blurSolid": 18, "saturate": "180%" },
  "source": {
    "bear": "#e8743b",
    "things": "#2c6bf0",
    "web": "#3b82f6",
    "finder": "#8a8a90"
  },
  "status": { "green": "#30d158", "danger": "#ff453a" },
  "color": {
    "uiBg":       { "dark": "rgba(28,28,30,0.72)",     "light": "rgba(250,250,252,0.72)" },
    "uiBg2":      { "dark": "rgba(58,58,62,0.50)",     "light": "rgba(255,255,255,0.70)" },
    "uiBorder":   { "dark": "rgba(255,255,255,0.10)",  "light": "rgba(0,0,0,0.08)" },
    "uiHairline": { "dark": "rgba(255,255,255,0.08)",  "light": "rgba(0,0,0,0.07)" },
    "uiShadow":   { "dark": "0 28px 64px -18px rgba(0,0,0,0.62), 0 2px 10px rgba(0,0,0,0.40)", "light": "0 28px 64px -18px rgba(0,0,0,0.24), 0 2px 10px rgba(0,0,0,0.10)" },
    "text1":      { "dark": "rgba(255,255,255,0.96)",  "light": "rgba(0,0,0,0.88)" },
    "text2":      { "dark": "rgba(235,235,245,0.62)",  "light": "rgba(60,60,67,0.60)" },
    "text3":      { "dark": "rgba(235,235,245,0.34)",  "light": "rgba(60,60,67,0.40)" },
    "accent":     { "dark": "#0a84ff",                 "light": "#007aff" },
    "accentSoft": { "dark": "rgba(10,132,255,0.20)",   "light": "rgba(0,122,255,0.14)" },
    "rowSelected":{ "dark": "rgba(10,132,255,0.26)",   "light": "rgba(0,122,255,0.16)" },
    "rowHover":   { "dark": "rgba(255,255,255,0.06)",  "light": "rgba(0,0,0,0.05)" },
    "ctrlBg":     { "dark": "rgba(255,255,255,0.09)",  "light": "rgba(0,0,0,0.05)" },
    "ctrlBgHover":{ "dark": "rgba(255,255,255,0.14)",  "light": "rgba(0,0,0,0.09)" },
    "ctrlBorder": { "dark": "rgba(255,255,255,0.12)",  "light": "rgba(0,0,0,0.10)" },
    "kbdBg":      { "dark": "rgba(255,255,255,0.08)",  "light": "rgba(0,0,0,0.05)" },
    "kbdBorder":  { "dark": "rgba(255,255,255,0.12)",  "light": "rgba(0,0,0,0.12)" },
    "kbdText":    { "dark": "rgba(235,235,245,0.60)",  "light": "rgba(60,60,67,0.60)" }
  },
  "directions": {
    "aurora":  { "radiusPanel": 17, "blur": 42, "selection": "fill", "note": "native macOS vibrancy, blue capsule selection" },
    "console": { "radiusPanel": 12, "blur": 18, "selection": "leftbar", "note": "denser/solid surface, accent left-bar selection" }
  },
  "sourceIcons": {
    "bear": "book", "things": "check-square", "web": "globe", "finder": "folder"
  }
}
