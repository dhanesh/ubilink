{
  "$meta": {
    "name": "Ubilink Design Tokens",
    "description": "Native macOS 27 (D26): the system font at macOS text-style sizes, AppKit's system colours as macOS 27.0.1 reports them (NSColor, sRGB), raised only where WCAG AA requires (each such value names its AppKit original in `aa`), a glass panel frame around an opaque card, and the user's live system accent (theme/accent.rs derives the accent roles; `accent.default` is the macOS default used when none can be read).",
    "themes": ["dark", "light"]
  },
  "font": {
    "ui": ".SystemUIFont",
    "mono": "\"SF Mono\", ui-monospace, Menlo, monospace"
  },
  "fontSize": { "display": 17, "title": 13, "row": 13, "body": 13, "meta": 12 },
  "fontWeight": { "regular": 400, "headline": 700 },
  "radius": { "panel": 18, "card": 14, "control": 6, "row": 6, "pill": 999 },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40 },
  "size": { "frame": 4, "control": 24, "row": 24 },
  "accent": { "default": "#007aff" },
  "color": {
    "windowBackground": { "light": "#ffffff", "dark": "#1e1e1e" },
    "underPageBackground": { "light": "#f6f6f6", "dark": "#282828" },
    "label": { "light": "rgba(0,0,0,0.85)", "dark": "rgba(255,255,255,0.85)" },
    "secondaryLabel": { "light": "rgba(0,0,0,0.54)", "dark": "rgba(255,255,255,0.55)", "aa": "light was rgba(0,0,0,0.50): 4.00:1 on #ffffff" },
    "tertiaryLabel": { "light": "rgba(0,0,0,0.26)", "dark": "rgba(255,255,255,0.25)" },
    "separator": { "light": "rgba(0,0,0,0.10)", "dark": "rgba(255,255,255,0.10)" },
    "controlBorder": { "light": "rgba(0,0,0,0.42)", "dark": "rgba(255,255,255,0.34)", "aa": "a text field's edge on the card at 3:1 (separatorColor, 0.10, is 1.26 / 1.36:1)" },
    "control": { "light": "rgba(0,0,0,0.06)", "dark": "rgba(255,255,255,0.14)" },
    "controlHover": { "light": "rgba(0,0,0,0.10)", "dark": "rgba(255,255,255,0.20)" },
    "controlActive": { "light": "rgba(0,0,0,0.14)", "dark": "rgba(255,255,255,0.26)" },
    "rowHover": { "light": "rgba(0,0,0,0.05)", "dark": "rgba(255,255,255,0.06)" },
    "switchOff": { "light": "rgba(0,0,0,0.42)", "dark": "rgba(255,255,255,0.34)", "aa": "the off track on the card at 3:1" },
    "switchThumb": { "light": "#ffffff", "dark": "#ffffff" },
    "danger": { "light": "#ee0005", "dark": "#ff4245", "aa": "light was systemRed #ff383c: 3.57:1 on #ffffff" },
    "dangerFill": { "light": "#ee0005", "dark": "#ee0005", "aa": "white text on systemRed is 3.57:1 (light #ff383c) / 3.43:1 (dark #ff4245)" },
    "success": { "light": "#24883d", "dark": "#30d158", "aa": "light was systemGreen #34c759: 2.22:1 on #ffffff" },
    "warning": { "light": "#be5900", "dark": "#ff9230", "aa": "light was systemOrange #ff8d28: 2.27:1 on #ffffff" }
  }
}
