{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hooky",
  "version": "0.0.1",
  "identifier": "org.linkingmanifesto.hooky",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "hooky",
        "width": 640,
        "height": 420,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
